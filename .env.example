# Copy to .env and adjust. .env is gitignored. Placeholders only; never commit real values.
# ORBIT_ENV: local (workstation, all engines) | dev | prod (hosted, persisted results only)
ORBIT_ENV=local
# Either a full URL (hosted Postgres, e.g. Neon) ...
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# ... or the discrete local fields
ORBIT_DB_HOST=localhost
ORBIT_DB_PORT=55432
ORBIT_DB_NAME=orbit
ORBIT_DB_USER=orbit
ORBIT_DB_PASSWORD=change_me
# Comma separated. Leave empty in prod: the web app and API share one origin.
ORBIT_CORS_ORIGINS=http://localhost:5173
ORBIT_SEED=20260101
ORBIT_LOG_LEVEL=INFO
ORBIT_API_PORT=8000
ORBIT_JAVA_PORT=8081
# Optional overrides
# ORBIT_LOCAL_ENGINES=true
# ORBIT_RATE_LIMIT_PER_MIN=600
# ORBIT_MAX_BODY_BYTES=32768
# Target for scripts/orbit.ps1 publish (hosted DB seeding). Set in the shell only, not in files.
# ORBIT_TARGET_DATABASE_URL=
